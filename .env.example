# Скопируй в .env и замени все значения change-me своими.
# Пароль в POSTGRES_PASSWORD и в DATABASE_URL должен быть одинаковым.
POSTGRES_USER=documind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=documind
DATABASE_URL=postgresql+asyncpg://documind:change-me@postgres:5432/documind
REDIS_URL=redis://redis:6379/0
# Сгенерировать: openssl rand -hex 32
JWT_SECRET_KEY=change-me
# Ключ API OpenAI (эмбеддинги и ответы чата); пусто = фейки без сети
# Модель чата можно сменить: CHAT_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# Сколько секунд ждать ответа OpenAI (для потока: очередного куска)
# OPENAI_TIMEOUT_SECONDS=60
# Поиск по документации в интернете (флаг web_search в запросе к чату). Наборы
# сайтов описаны в backend/app/rag/web_profiles.json; профиль по умолчанию:
# WEB_DEFAULT_PROFILE=backend
# Ключ Tavily (tavily.com): поиск по этим сайтам и тексты страниц. Без него поиск
# идёт через OpenAI, но на длинных списках сайтов он часто ничего не находит
# Личные списки сайтов пользователей (/my-web-profiles) работают только с этим ключом
TAVILY_API_KEY=
# На сколько секунд кэшировать найденные страницы документации (0 — не кэшировать)
# WEB_CACHE_TTL_SECONDS=86400
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
